# Server Configuration
CLOUD_HOST=0.0.0.0
CLOUD_PORT=8001

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hanzo_cloud
REDIS_URL=redis://localhost:6379

# JWT Secret (change in production!)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Provider API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DIGITALOCEAN_API_KEY=your_digitalocean_api_key_here

# Zoo-gym Integration
ZOO_GYM_PATH=/Users/z/work/zoo/gym
EXPERIENCE_LIB_PATH=./experiences

# GRPO Settings
GRPO_ENABLED=true
GRPO_GROUP_SIZE=5
GRPO_MAX_OPERATIONS=3

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Hanzo ID (OAuth/OIDC - https://hanzo.id)
HANZO_ID_URL=https://hanzo.id
HANZO_ID_CLIENT_ID=your_client_id
HANZO_ID_CLIENT_SECRET=your_client_secret

# Local LLM Node (optional)
LOCAL_NODE_URL=http://localhost:8000

# Logging
RUST_LOG=hanzo_cloud=debug,tower_http=debug,sqlx=warn
